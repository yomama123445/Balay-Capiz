{
  "name": "balaycapiz-portal",
  "private": true,
  "version": "1.0.0",
  "description": "BalayCapiz — Verified Student Boarding House & Safety Portal for Hercor College, CapSU Main, and Filamer Christian University in Roxas City, Capiz",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "cap:install": "npm install @capacitor/core @capacitor/cli @capacitor/android @capacitor/ios @capacitor/geolocation @capacitor/camera @capacitor/status-bar @capacitor/splash-screen",
    "cap:add:android": "npx cap add android",
    "cap:add:ios": "npx cap add ios",
    "build:mobile": "vite build && npx cap sync",
    "open:android": "npx cap open android",
    "open:ios": "npx cap open ios",
    "android:apk:debug": "vite build && npx cap sync android && cd android && ./gradlew assembleDebug",
    "android:apk:release": "vite build && npx cap sync android && cd android && ./gradlew assembleRelease",
    "android:aab:release": "vite build && npx cap sync android && cd android && ./gradlew bundleRelease",
    "db:seed": "npx tsx scripts/seed_supabase.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/camera": "^8.2.6",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/geolocation": "^8.2.4",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite-plugin-pwa": "^2.0.0"
  }
}

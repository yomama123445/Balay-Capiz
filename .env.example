# ============================================================================
# BalayCapiz — Environment Variables Configuration
# Copy this file to `.env.local` and fill in your credentials
# ============================================================================

# 1. Supabase Cloud Backend (PostgreSQL + Storage)
# Create a free project at https://supabase.com (Region: Singapore ap-southeast-1)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-public-key"

# 2. Gemini AI Studio Key (Optional — for AI housing assistant features)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# 3. Public Deployment URL (Used for QR Code Poster & Deep Links)
APP_URL="https://balaycapiz.vercel.app"

# 4. Android Release Signing (Used by Gradle when running `npm run android:aab:release`)
BALAYCAPIZ_UPLOAD_STORE_FILE="balaycapiz-release.keystore"
BALAYCAPIZ_UPLOAD_STORE_PASSWORD="your-keystore-password"
BALAYCAPIZ_UPLOAD_KEY_ALIAS="balaycapiz"
BALAYCAPIZ_UPLOAD_KEY_PASSWORD="your-key-password"
